APP_NAME=ArtifactHost
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Chicago
APP_URL=https://hosting-api.champlinenterprises.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artifact_host
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# artifact-host specifics
ARTIFACTHOST_APEX=hosting.champlinenterprises.com
ARTIFACTHOST_LE_EMAIL=admin@champlinenterprises.com
ARTIFACTHOST_MAX_FILE_BYTES=5242880
ARTIFACTHOST_MAX_TOTAL_BYTES=104857600

# Plesk REST API (run on-box → host=127.0.0.1 typical)
PLESK_HOST=127.0.0.1
PLESK_PORT=8443
PLESK_API_KEY=

# Plesk subscription that owns the apex. If apex is a subdomain of a larger
# domain (typical), set this to the parent. If apex is its own primary domain,
# leave equal to apex.
ARTIFACTHOST_SUBSCRIPTION_DOMAIN=champlinenterprises.com
